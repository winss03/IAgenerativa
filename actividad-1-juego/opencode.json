{
  "$schema": "https://opencode.ai/config.json",
  "model": "agnes/agnes-2.5-flash",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },

  "providers": {
    "agnes": {
      "name": "Agnes AI",
      "env": ["AGNES_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",

      "settings": {
        "baseURL": "https://apihub.agnes-ai.com/v1"
      },

      "models": {
        "agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash"
        },
        "agnes-2.0-flash": {
          "name": "Agnes 2.0 Flash"
        }
      }
    }
  }
}
